PORT=3100
DATABASE_URL=postgres://wagering:wagering@localhost:55432/wagering
DB_POOL_MAX=20
LOCK_TIMEOUT_MS=5000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ_QUEUE=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_SECONDS=30
SQS_RETRY_BASE_SECONDS=2
SQS_RETRY_MAX_SECONDS=60

# Workers (todos ligados por padrão; cada instância roda os três)
CONSUMER_ENABLED=true
OUTBOX_ENABLED=true
PENDING_WORKER_ENABLED=true
OUTBOX_INTERVAL_MS=500
PENDING_INTERVAL_MS=1000

# Referências pendentes (FR-022): base 1 s, teto 5 min, prazo 1 h
PENDING_BACKOFF_BASE_MS=1000
PENDING_BACKOFF_MAX_MS=300000
PENDING_TTL_MS=3600000

# Somente em teste: crash_after_commit_before_ack | crash_after_commit_before_publish |
# crash_after_publish_before_mark | permanent_error_in_use_case
FAULT_INJECTION=

LOG_LEVEL=info
RUN_MIGRATIONS=false
SHUTDOWN_GRACE_MS=20000
